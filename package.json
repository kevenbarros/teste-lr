{
  "name": "lampada-relogio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch server.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "ir:scan": "node scripts/ir-scan.js",
    "ir:debug": "node scripts/ir-debug.js",
    "ir:learn:on": "node scripts/ir-learn.js on",
    "ir:learn:off": "node scripts/ir-learn.js off",
    "gen:beep": "node scripts/gen-beep.js",
    "sound:test": "node -e \"import('./soundPlayer.js').then(m=>m.playAlert())\""
  },
  "dependencies": {
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tuyapi": "^7.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
